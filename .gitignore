# OS
.DS_Store
Thumbs.db

# Runtime data
/estudios/*
# Se excluye el CONTENIDO de Multimedia, no el directorio: git no desciende en un
# directorio excluido, y entonces la excepción de abajo nunca llegaría a evaluarse.
/default/Multimedia/*
# Excepción: el material sintético de los protocolos de prueba. Pesa poco y sin él
# esos protocolos no funcionan en otra máquina.
!/default/Multimedia/PRUEBA*
/CurrentExperiment.log
/CurrentExperiment_Events.log
/EEGControl.log
/params.txt
/Tokens.txt
/~$*

# Old build artifacts
/lib/
/windows-repository/

# Claude Code
CLAUDE.md
.claude/
dependency-reduced-pom.xml

# Directorio literal que Log4j crearía si la configuración se cargara sin las
# propiedades del sistema definidas (ver EEGFX-29)
${sys:studyBaseDir}/
